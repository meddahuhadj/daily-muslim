{
  "hadiths": [
    {
      "collection": "muslim",
      "text": "بِنَاءِ الرَّجُلِ فَوْقَ الرَّجُلِ فِي السَّمَاءِ",
      "ref": "Sahih Muslim 263"
    },
    {
      "collection": "muslim",
      "text": "الإِسْلَامُ بِالإِيمَانِ وَالعَمَلِ الصَّالِحِ",
      "ref": "Sahih Muslim 161"
    },
    {
      "collection": "tirmidhi",
      "text": "الدُّنْيَا سُجُونُ الَّذِينَ كَفَرُوا",
      "ref": "Jami' at-Tirmidhi 2077"
    },
    {
      "collection": "abu_dawud",
      "text": "الدُّعَاءُ لَا يُرَدُّ إِلَّا بِالبَلَاءِ أَوِ انتِظَارِ الْخَيْرِ",
      "ref": "Sunan Abi Dawud 5134"
    },
    {
      "collection": "an_nasa'i",
      "text": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَعَلَى آلِ مُحَمَّدٍ",
      "ref": "Sunan an-Nasa'i 1292"
    },
    {
      "collection": "ibn_majah",
      "text": "الحَيَاةُ فِي الدُّنْيَا مَزْرَعُ الْآخِرَةِ",
      "ref": "Sunan Ibn Majah 4105"
    },
    {
      "collection": "malik",
      "text": "لَا ضَرَرَ وَلَا ضِرَارَ",
      "ref": "al-Muwatta 1311"
    },
    {
      "collection": "nasai_sharif",
      "text": "اللَّهُمَّ اجْعَلْنِي مِنَ الَّذِينَ يَذْكُرُونَكَ كَثِيرًا",
      "ref": "Sunan an-Nasa'i al-Sharif 1293"
    },
    {
      "collection": "muslim",
      "text": "القَرْآنُ يَقْرَأُ عَلَيْكُمْ بِأَعْمَالِكُمْ",
      "ref": "Sahih Muslim 1853"
    },
    {
      "collection": "tirmidhi",
      "text": "البِرُّ بِالإِخْوَانِ وَالصَّلَاةُ بِالإِخْوَانِ",
      "ref": "Jami' at-Tirmidhi 1922"
    },
    {
      "collection": "abu_dawud",
      "text": "مَنْ سَرَّ فَلْيُخْفِضْ صَوْتَهُ",
      "ref": "Sunan Abi Dawud 4932"
    },
    {
      "collection": "an_nasa'i",
      "text": "اللَّهُمَّ ارْزُقْنِي فَضْلَكَ",
      "ref": "Sunan an-Nasa'i 1294"
    },
    {
      "collection": "ibn_majah",
      "text": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَعَلَى آلِ مُحَمَّدٍ",
      "ref": "Sunan Ibn Majah 959"
    },
    {
      "collection": "malik",
      "text": "الإِيمَانُ بِاللَّهِ وَاليَوْمِ الْآخِرِ",
      "ref": "al-Muwatta 1"
    },
    {
      "collection": "nasai_sharif",
      "text": "اللَّهُمَّ اجْعَلْنِي مِنَ التَّابِينَ",
      "ref": "Sunan an-Nasa'i al-Sharif 1295"
    }
  ]
}